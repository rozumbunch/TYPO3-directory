{
    "name": "rozumbunch/directory",
    "version": "1.0.1",
    "type": "typo3-cms-extension",
    "description": "Directory of persons, organisations and locations",
    "license": ["GPL-2.0-or-later"],
    "authors": [
        {
            "name": "Rozumbunch",
            "role": "Developer"
        }
    ],
    "keywords": [
        "TYPO3",
        "directory",
        "person",
        "organisation",
        "location"
    ],
    "require": {
        "php": "^8.2",
        "typo3/cms-backend": "^13.4 || ^14.0",
        "typo3/cms-core": "^13.4 || ^14.0",
        "typo3/cms-extbase": "^13.4 || ^14.0",
        "typo3/cms-fluid": "^13.4 || ^14.0",
        "typo3/cms-frontend": "^13.4 || ^14.0"
    },
    "autoload": {
        "psr-4": {
            "Rozumbunch\\Directory\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "directory"
        }
    }
}
